model User {
    id            String    @id @default(cuid())
    name          String
    email         String    @unique
    emailVerified Boolean
    image         String?
    session       Session[]
    account       Account[]
    basket        Basket?
    order         Order[]
    createdAt     DateTime  @db.Timestamptz(3)
    updatedAt     DateTime  @db.Timestamptz(3)
}
