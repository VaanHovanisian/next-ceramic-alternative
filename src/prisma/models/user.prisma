model User {
  id            String    @id @default(cuid())
  name          String
  role          UserRole  @default(USER)
  email         String    @unique
  emailVerified Boolean
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  account       Account[]
  basket        Basket?
  orders        Order[]
  session       Session[]
}

enum UserRole {
  ADMIN
  USER
}
